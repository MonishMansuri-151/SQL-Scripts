-- after insert the data from main table and trigger are hit and store the data in to backup table -----------------------------



CREATE OR REPLACE TRIGGER new_trigger
AFTER INSERT ON main
FOR EACH ROW
BEGIN
    INSERT INTO backup_1 (
        emp_id,
        first_name,
        action_date
    )
    VALUES (
        :NEW.employee_id,
        :NEW.first_name,
        SYSDATE
    );
END;
